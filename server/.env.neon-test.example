# Copy this file to server/.env.neon-test and keep the copied file out of Git.
# Run commands from server/ with: bun --env-file=.env.neon-test run db:neon:prepare
DATABASE_URL=postgresql://user:password@test-branch-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_DRIVER=neon
DATABASE_ENVIRONMENT=test

# Compose parses the base local-db service before applying the Neon override.
# This satisfies that unused interpolation; no local database is started.
POSTGRES_PASSWORD=unused-by-neon-override

# Copy only the hostname portion from DATABASE_URL. The preflight requires an
# exact match, preventing an accidental migration of another Neon branch.
NEON_TEST_HOST=test-branch-pooler.region.aws.neon.tech

# Runtime values required when starting the API against this database.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
LINE_CHANNEL_ID=replace-with-line-channel-id
LINE_CHANNEL_SECRET=replace-with-line-channel-secret
UPLOAD_DIR=uploads
