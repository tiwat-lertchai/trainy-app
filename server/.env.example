NODE_ENV=development
PORT=3000
# Separate multiple trusted origins with commas.
CORS_ORIGINS=http://localhost:5173

# Copy the pooled connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# LINE Login channel credentials from the LINE Developers Console.
# Register this callback URL: http://localhost:3000/api/auth/callback/line
LINE_CHANNEL_ID=replace-with-line-channel-id
LINE_CHANNEL_SECRET=replace-with-line-channel-secret
