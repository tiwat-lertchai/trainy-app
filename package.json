{
  "name": "trainy-app",
  "version": "0.5.1",
  "description": "Trainy: internship management platform connecting students, universities, and companies through one internship workflow.",
  "author": "Tiwat Lertchai",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "./server",
    "./client",
    "./shared"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:client": "turbo dev --filter=client",
    "dev:server": "turbo dev --filter=server",
    "build": "turbo build",
    "build:client": "turbo build --filter=client",
    "build:server": "turbo build --filter=server",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "audit": "bun audit",
    "verify:fast": "bun run audit && bun run fmt:check && bun run type-check && bun run lint && bun run test && bun run build",
    "fmt": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "fmt:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "postinstall": "turbo build --filter=shared --filter=server"
  },
  "keywords": [
    "bun",
    "hono",
    "react",
    "vite",
    "monorepo",
    "turbo"
  ],
  "devDependencies": {
    "bun-types": "^1.4.2",
    "prettier": "^3.9.7",
    "turbo": "^2.10.13"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "overrides": {
    "esbuild": "0.25.12"
  }
}
