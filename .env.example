# Copy to .env and fill in real values before running:
#   docker compose up --build
#
# Client and server share one origin here: nginx (the client container)
# reverse-proxies /api/ to the server container (see client/nginx.conf), so
# CORS_ORIGINS and BETTER_AUTH_URL must use the SAME real public URL that the
# browser loads. Compose intentionally has no localhost fallback for either
# value, so a deployment cannot silently start with invalid OAuth trust settings.
# VITE_SERVER_URL is used only by non-production Vite development builds.

# Password for the app's own Postgres container (db service). Pick anything
# strong; this database is created fresh by the container, not Neon.
POSTGRES_PASSWORD=replace-with-a-strong-password

# The one public URL this whole app is served from, e.g. https://trainy.app
# (use https in any real deployment; http://localhost:8081 is only for
# testing the compose stack on this machine).
CORS_ORIGINS=http://localhost:8081
BETTER_AUTH_URL=http://localhost:8081
VITE_SERVER_URL=http://localhost:8081

# Keep false when the Bun server is reachable directly. The Compose production
# topology sets this to true inside the server container because nginx is the
# only entry point and overwrites X-Real-IP with the real client address.
TRUST_PROXY_IP_HEADERS=false

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# LINE Login channel credentials from the LINE Developers Console. Register
# the callback URL <the URL above>/api/auth/callback/line there.
LINE_CHANNEL_ID=replace-with-line-channel-id
LINE_CHANNEL_SECRET=replace-with-line-channel-secret

# SMTP credentials for email verification and password resets. Use port 465
# with SMTP_SECURE=true, or port 587 with SMTP_SECURE=false (STARTTLS).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="Trainy <no-reply@example.com>"

# Stable university installation identity for legal documents (defaults to auth origin).
LEGAL_INSTALLATION_ID=
