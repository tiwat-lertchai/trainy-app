# Copy to .env and fill in real values before running:
#   docker compose up --build

# Password for the app's own Postgres container (db service). Pick anything
# strong; this database is created fresh by the container, not Neon.
POSTGRES_PASSWORD=replace-with-a-strong-password

# Public URL the browser will load the client from.
CORS_ORIGINS=http://localhost:8081

# Public URL the server is reachable at (used by Better Auth and for the LINE
# OAuth callback: <BETTER_AUTH_URL>/api/auth/callback/line).
BETTER_AUTH_URL=http://localhost:3001

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# LINE Login channel credentials from the LINE Developers Console.
LINE_CHANNEL_ID=replace-with-line-channel-id
LINE_CHANNEL_SECRET=replace-with-line-channel-secret

# Baked into the client build at build time (Vite) — the URL the browser
# calls the API on. Must match where the server is actually reachable, not
# the internal Docker service name.
VITE_SERVER_URL=http://localhost:3001
